  "info": {
    "title": "Social Chat App API",
    "description": "Hệ thống REST API cho ứng dụng Mạng xã hội & Chat Realtime — Xây dựng với NestJS, PostgreSQL & Prisma ORM",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Nhập JWT Access Token của bạn vào đây",
        "in": "header"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Nguyễn Văn A",
            "description": "Họ và tên hiển thị của người dùng"
          },
          "bio": {
            "type": "string",
            "example": "Lập trình viên Full-Stack đam mê NestJS và React",
            "description": "Tiểu sử cá nhân (Bio)"
          },
          "location": {
            "type": "string",
            "example": "Hà Nội, Việt Nam",
            "description": "Nơi sinh sống hoặc địa điểm làm việc"
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Họ và tên người dùng",
            "example": "Alice Nguyen"
          },
          "email": {
            "type": "string",
            "description": "Địa chỉ email người dùng",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu người dùng (tối thiểu 6 ký tự)",
            "example": "Password@123",
            "minLength": 6
          }
        },
        "required": ["name", "email", "password"]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "published": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["title", "content"]
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
